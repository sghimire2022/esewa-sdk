# Copy to .env. Every value is optional in development: the server falls back
# to eSewa's public test credentials.

# "test" uses eSewa's UAT servers (rc-epay.esewa.com.np); "production" is live money.
ESEWA_ENV=test

# Issued by eSewa. Test values: EPAYTEST / 8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# The public URL the customer's browser uses to reach this app. eSewa redirects
# the customer back here after payment.
#   dev (Vite):        http://localhost:5173
#   prod (Express):    https://example.com
APP_URL=http://localhost:5173

PORT=3000
